---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getReadingTime } from "@/utils/readingTime";
import {
  getHandbookPath,
  getAdjacentChapters,
  isGuide,
  isTopic,
  handbookMeta,
  type HandbookEntry,
} from "@/utils/handbook";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n/utils";
import "@/styles/post-details.css";

type Props = {
  entry: HandbookEntry;
  chapters: HandbookEntry[];
};

const { entry, chapters } = Astro.props;
const locale = Astro.currentLocale || "zh";
const t = useTranslations(locale);

const { title, description, part } = entry.data;
const { Content, headings } = await render(entry);
const readingTime = entry.body ? getReadingTime(entry.body, locale) : null;
const hasToc = headings.filter(h => h.depth > 1 && h.depth < 4).length > 0;
const { prev, next } = getAdjacentChapters(chapters, entry);

const kindLabel = isGuide(entry)
  ? t("handbook.guide")
  : isTopic(entry)
    ? t("handbook.topic")
    : part;
---

<Layout
  title={`${title} | ${SITE.title}`}
  description={description}
  scrollSmooth={true}
>
  <div class="progress-container">
    <div class="progress-bar" id="reading-progress-bar"></div>
  </div>
  <Header />
  <Breadcrumb withBackButton />
  <main
    id="main-content"
    class="relative mx-auto w-full max-w-4xl px-4 pb-12 lg:max-w-5xl xl:max-w-6xl"
    data-pagefind-body
    data-resume-question={t("post.resumeQuestion")}
    data-resume-btn={t("post.resumeBtn")}
  >
    <!-- Chapter header -->
    <header class="post-header relative mb-10 text-center">
      <div class="post-hero-bg"></div>
      <div class="relative z-10 rounded-3xl border border-border/20 bg-muted/5 px-6 py-8 backdrop-blur-md sm:px-10 sm:py-12">
        <div class="mb-4 flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/25 bg-accent/8 px-3 py-1 font-firacode text-xs font-semibold tracking-wider text-accent">
            {kindLabel}
          </span>
          <a
            href="/handbook"
            class="inline-flex items-center gap-1 rounded-full border border-border/25 bg-muted/10 px-3 py-1 font-firacode text-xs text-foreground/60 transition-colors hover:border-accent/30 hover:text-accent"
          >
            {t("handbook.backToToc")}
          </a>
        </div>
        <h1 class="post-title text-3xl leading-tight font-bold tracking-tight sm:text-4xl lg:text-[2.75rem]">
          {title}
        </h1>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm">
          {readingTime && (
            <div class="inline-flex items-center gap-1.5 rounded-lg border border-border/25 bg-muted/10 px-2.5 py-1 backdrop-blur-sm">
              <svg
                class="size-3.5 text-accent/70"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                <path d="M12 7v5l3 3" />
              </svg>
              <span class="text-sm opacity-70">{readingTime}</span>
            </div>
          )}

          <button
            id="read-mode-btn"
            class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-border/25 bg-muted/10 px-2.5 py-1 opacity-70 backdrop-blur-sm transition-all duration-200 hover:border-accent/30 hover:opacity-100"
            title={
              locale === "en"
                ? "Toggle Reading Mode (Shortcut: r)"
                : "切换阅读模式（快捷键：r）"
            }
            aria-label={t("post.readMode")}
          >
            <svg
              class="size-3.5 text-accent/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            <span class="text-sm">{t("post.readMode")}</span>
          </button>
        </div>
      </div>
    </header>

    {hasToc ? (
      <div class="mt-8 grid w-full grid-cols-1 items-start lg:grid-cols-[1fr_250px] lg:gap-12">
        <details class="mobile-toc group mb-6 rounded-2xl border border-border/20 bg-muted/5 px-4 py-3 backdrop-blur-sm lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between font-firacode text-xs font-semibold tracking-wider text-foreground/80 uppercase select-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2">
              <svg
                class="size-4 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="8" y1="6" x2="21" y2="6" />
                <line x1="8" y1="12" x2="21" y2="12" />
                <line x1="8" y1="18" x2="21" y2="18" />
                <line x1="3" y1="6" x2="3.01" y2="6" />
                <line x1="3" y1="12" x2="3.01" y2="12" />
                <line x1="3" y1="18" x2="3.01" y2="18" />
              </svg>
              {t("toc.title")}
            </span>
            <svg
              class="size-4 text-foreground/50 transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="mt-3 border-t border-border/15 pt-3">
            <TableOfContents headings={headings} isMobile={true} />
          </div>
        </details>
        <article
          id="article"
          class="app-prose w-full max-w-none lg:max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
        >
          <Content />
        </article>
        <aside class="sidebar-toc sticky top-24 hidden max-h-[calc(100vh-8rem)] overflow-y-auto pr-2 lg:block">
          <TableOfContents headings={headings} />
          <div class="mt-8 border-t border-border/15 pt-6">
            <ShareLinks isSidebar={true} />
          </div>
        </aside>
      </div>
    ) : (
      <article
        id="article"
        class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
      >
        <Content />
      </article>
    )}

    <!-- End separator -->
    <div
      class="relative mt-12 mb-8 flex items-center justify-center gap-4"
      aria-hidden="true"
    >
      <div class="relative h-px flex-1 bg-linear-to-r from-transparent via-border/30 to-accent/20">
        <div class="absolute inset-0 bg-linear-to-r from-transparent via-accent/40 to-accent/40 blur-[2px]"></div>
      </div>
      <div class="relative z-10 flex items-center gap-2 font-firacode text-[10px] tracking-widest text-accent/80 uppercase select-none">
        <span class="h-1.5 w-1.5 rounded-full bg-accent/70 shadow-[0_0_8px_var(--color-accent)]"></span>
        end
      </div>
      <div class="relative h-px flex-1 bg-linear-to-l from-transparent via-border/30 to-accent/20">
        <div class="absolute inset-0 bg-linear-to-l from-transparent via-accent/40 to-accent/40 blur-[2px]"></div>
      </div>
    </div>

    <div
      class:list={["mt-6 mb-8 flex justify-center", { "lg:hidden": hasToc }]}
    >
      <ShareLinks />
    </div>

    <!-- Attribution -->
    <div
      data-pagefind-ignore
      class="mb-8 rounded-2xl border border-border/20 bg-muted/5 px-5 py-4 text-xs leading-relaxed text-foreground/55"
    >
      {t("handbook.licenseNote")}
      <a
        href={handbookMeta.repository}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 text-accent underline decoration-dashed underline-offset-4 hover:text-accent/80"
      >
        {t("handbook.viewSource")}
      </a>
    </div>

    <!-- Previous / Next chapter (book order) -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {prev ? (
        <a
          href={getHandbookPath(prev.id)}
          class="post-nav-link group relative flex flex-col gap-1.5 rounded-2xl border border-border/20 px-5 py-4 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
        >
          <div class="post-nav-bg" />
          <div class="flex items-center gap-1.5">
            <svg
              class="size-3.5 text-accent/50 transition-transform duration-300 group-hover:-translate-x-1 rtl:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span class="font-firacode text-[10px] tracking-wider text-foreground/35 uppercase">
              {t("handbook.prev")}
            </span>
          </div>
          <span class="line-clamp-2 text-sm leading-snug font-medium text-foreground/70 transition-colors duration-200 group-hover:text-accent">
            {prev.data.title}
          </span>
          <span class="font-firacode text-[10px] text-foreground/40">
            {prev.data.part}
          </span>
        </a>
      ) : (
        <div class="hidden sm:block" />
      )}
      {next && (
        <a
          href={getHandbookPath(next.id)}
          class="post-nav-link group relative flex flex-col items-end gap-1.5 rounded-2xl border border-border/20 px-5 py-4 text-end transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
        >
          <div class="post-nav-bg" />
          <div class="flex items-center gap-1.5">
            <span class="font-firacode text-[10px] tracking-wider text-foreground/35 uppercase">
              {t("handbook.next")}
            </span>
            <svg
              class="size-3.5 text-accent/50 transition-transform duration-300 group-hover:translate-x-1 rtl:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </div>
          <span class="line-clamp-2 text-sm leading-snug font-medium text-foreground/70 transition-colors duration-200 group-hover:text-accent">
            {next.data.title}
          </span>
          <span class="font-firacode text-[10px] text-foreground/40">
            {next.data.part}
          </span>
        </a>
      )}
    </div>
  </main>

  <!-- Reading Mode Floating Controls -->
  <div
    id="reading-controls-pill"
    class="pointer-events-none fixed bottom-6 left-1/2 z-100 flex -translate-x-1/2 translate-y-10 scale-95 items-center gap-4 rounded-full border border-accent/20 bg-background/85 px-6 py-3 opacity-0 shadow-2xl backdrop-blur-md transition-all duration-300 hover:border-accent/40"
  >
    <div class="animate-reading-halo pointer-events-none absolute -inset-1.5 -z-10 rounded-full bg-accent/20 blur-md"></div>

    <div class="flex items-center gap-1.5">
      <button
        id="reading-font-sans"
        class="cursor-pointer rounded-full bg-accent px-2.5 py-1 text-xs font-medium text-background transition-colors hover:bg-accent/80"
        title={locale === "en" ? "Sans Serif Font" : "无衬线字体"}
      >
        Sans
      </button>
      <button
        id="reading-font-serif"
        class="cursor-pointer rounded-full px-2.5 py-1 text-xs font-medium text-foreground/60 transition-colors hover:bg-foreground/5 hover:text-foreground"
        title={locale === "en" ? "Serif Font" : "衬线字体"}
      >
        Serif
      </button>
    </div>

    <div class="h-4 w-px bg-border/40"></div>

    <div class="flex items-center gap-2">
      <button
        id="reading-size-dec"
        class="cursor-pointer rounded-full p-1 text-foreground/60 transition-colors hover:bg-foreground/5 hover:text-foreground"
        title={locale === "en" ? "Decrease Font Size" : "减小字号"}
        aria-label={locale === "en" ? "Decrease Font Size" : "减小字号"}
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
      <span
        id="reading-size-display"
        class="min-w-[3ch] text-center font-mono text-xs font-medium"
      >
        100%
      </span>
      <button
        id="reading-size-inc"
        class="cursor-pointer rounded-full p-1 text-foreground/60 transition-colors hover:bg-foreground/5 hover:text-foreground"
        title={locale === "en" ? "Increase Font Size" : "增大字号"}
        aria-label={locale === "en" ? "Increase Font Size" : "增大字号"}
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>

    <div class="h-4 w-px bg-border/40"></div>

    <button
      id="reading-exit-btn"
      class="flex cursor-pointer items-center gap-1.5 rounded-full bg-foreground/10 px-3 py-1 text-xs font-semibold text-foreground transition-colors hover:bg-foreground/15"
      title={
        locale === "en"
          ? "Exit Reading Mode (Shortcut: r)"
          : "退出阅读模式（快捷键：r）"
      }
    >
      <span>{t("post.exit")}</span>
      <kbd class="hidden rounded border border-foreground/20 bg-foreground/5 px-1.5 py-0.5 text-[9px] opacity-60 sm:inline-block">
        R
      </kbd>
    </button>
  </div>

  <BackToTopButton />
  <Footer />
</Layout>

<script>
  import {
    initReadingMode,
    cleanupReadingMode,
  } from "@/scripts/post-reading-mode";
  import { addHeadingLinks, attachCopyButtons } from "@/scripts/code-copy";
  import {
    initProgressBarFallback,
    initReadingPosition,
    cleanupPostProgress,
  } from "@/scripts/post-progress";

  document.addEventListener("astro:page-load", () => {
    const pathname = window.location.pathname;
    const isChapterPage = /^\/handbook\/.+/.test(pathname);

    if (!isChapterPage) {
      cleanupReadingMode();
      cleanupPostProgress();
      return;
    }

    try {
      initProgressBarFallback();
    } catch {}
    try {
      addHeadingLinks();
    } catch {}
    try {
      attachCopyButtons();
    } catch {}
    try {
      initReadingPosition();
    } catch {}
    try {
      initReadingMode();
    } catch {}
  });
</script>
