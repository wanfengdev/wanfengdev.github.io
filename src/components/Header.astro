---
/**
 * Header.astro
 *
 * Sticky navigation header with blurred scroll filter, fully expanded
 * navigation links, responsive mobile menu, compact audio player, and
 * bilingual switcher (always the last nav item).
 *
 * Styles live in src/styles/header.css and client logic in src/scripts/header.ts.
 */
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import MobileMenu from "./MobileMenu.astro";
import IntroAudioCompact from "./IntroAudioCompact.astro";
import { SITE } from "@/config";
import {
  useTranslations,
  getTargetLanguageUrl,
  isActive as checkRouteActive,
} from "@/i18n/utils";
import "@/styles/header.css";

const { pathname } = Astro.url;

const locale = Astro.currentLocale || "zh";
const t = useTranslations(locale);
const targetLocale = locale === "en" ? "zh" : "en";
const targetLanguageUrl = getTargetLanguageUrl(pathname, targetLocale);
const langToggleTitle = locale === "en" ? "切换到中文" : "Switch to English";
const langChipLabel = targetLocale === "en" ? "EN" : "中文";
const prefix = locale === "en" ? "/en" : "";

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => checkRouteActive(currentPath, path);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute inset-s-16 -top-full z-50 rounded-b-lg bg-accent px-4 py-2 font-medium text-background transition-all focus:top-0"
>
  {t("nav.skip")}
</a>

<header
  id="main-header"
  class="sticky top-0 z-40 w-full transition-colors duration-300"
>
  <div class="header-scrolled-filter w-full">
    <div class="app-layout">
      <div
        id="top-nav-wrap"
        class:list={[
          "py-3 sm:py-5",
          "relative z-30 w-full",
          "flex items-center justify-between gap-2 sm:gap-4",
          "transition-all duration-300",
        ]}
      >
        <!-- Logo -->
        <a
          href={prefix || "/"}
          aria-label={
            locale === "en" ? `${SITE.title} Home` : `${SITE.title}首页`
          }
          class="group relative z-20 flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight sm:text-2xl"
        >
          <span class="nav-logo-text">{SITE.title}</span>
        </a>

        <!-- Center Audio Player -->
        {SITE.introAudio.enabled && (
          <div class="flex min-w-0 flex-1 justify-center">
            <IntroAudioCompact
              src={SITE.introAudio.src}
              label={SITE.introAudio.label}
              duration={SITE.introAudio.duration}
              isStream={SITE.introAudio.isStream}
              class="nav-intro-audio-compact"
            />
          </div>
        )}

        <!-- Nav area -->
        <nav id="nav-menu" class="flex shrink-0 items-center gap-1.5 lg:gap-1">
          <!-- Mobile search button (visible only on screens < 1024px) -->
          <button
            data-search-trigger
            class="nav-icon-btn lg:hidden!"
            title={locale === "en" ? "Search" : "搜索"}
            aria-label={t("nav.openSearch")}
          >
            <IconSearch class="size-4.5" />
          </button>

          <!-- Mobile language switcher chip (visible only on screens < 1024px) -->
          <a
            href={targetLanguageUrl}
            class="nav-lang-chip lg:hidden!"
            title={langToggleTitle}
            aria-label={langToggleTitle}
            data-lang-toggle={targetLocale}
          >
            <svg
              class="nav-lang-chip-icon size-3.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5"
              ></path>
            </svg>
            <span class="nav-lang-chip-label">{langChipLabel}</span>
          </a>

          <!-- Mobile hamburger (animated lines) -->
          <button
            id="menu-btn"
            class="hamburger-btn lg:hidden"
            aria-label={t("nav.openMenu")}
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-label-open={t("nav.openMenu")}
            data-label-close={t("nav.closeMenu")}
          >
            <div class="hamburger-box">
              <span class="hamburger-line hamburger-line--1"></span>
              <span class="hamburger-line hamburger-line--2"></span>
              <span class="hamburger-line hamburger-line--3"></span>
            </div>
          </button>

          <!-- Desktop links (always visible on lg+) -->
          <ul class="hidden lg:flex lg:flex-row lg:items-center lg:gap-1">
            <!-- Primary nav: all sections expanded -->
            <li>
              <a
                href={`${prefix}/posts`}
                class:list={["nav-link", { "nav-active": isActive("/posts") }]}
              >
                {t("nav.posts")}
              </a>
            </li>
            <li>
              <a
                href={`${prefix}/handbook`}
                class:list={[
                  "nav-link",
                  { "nav-active": isActive("/handbook") },
                ]}
              >
                {t("nav.handbook")}
              </a>
            </li>
            <li>
              <a
                href={`${prefix}/about`}
                class:list={["nav-link", { "nav-active": isActive("/about") }]}
              >
                {t("nav.about")}
              </a>
            </li>
            <li>
              <a
                href={`${prefix}/tags`}
                class:list={["nav-link", { "nav-active": isActive("/tags") }]}
              >
                {t("nav.tags")}
              </a>
            </li>
            {SITE.showArchives && (
              <li>
                <a
                  href={`${prefix}/archives`}
                  class:list={[
                    "nav-link",
                    { "nav-active": isActive("/archives") },
                  ]}
                >
                  {t("nav.archives")}
                </a>
              </li>
            )}
            {SITE.showGalleries && (
              <li>
                <a
                  href={`${prefix}/galleries`}
                  class:list={[
                    "nav-link",
                    { "nav-active": isActive("/galleries") },
                  ]}
                >
                  {t("nav.galleries")}
                </a>
              </li>
            )}

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- Search ⌘K -->
            <li class="flex items-center">
              <button
                data-search-trigger
                class="nav-search-btn"
                title={locale === "en" ? "Search (⌘K)" : "搜索 (⌘K)"}
                aria-label={t("nav.openSearch")}
                aria-keyshortcuts="Meta+K"
              >
                <IconSearch class="size-4" />
                <kbd class="nav-kbd">⌘K</kbd>
              </button>
            </li>

            <!-- Theme toggle -->
            {SITE.lightAndDarkMode && (
              <li class="flex items-center">
                <button
                  id="theme-btn"
                  class="nav-icon-btn"
                  title={t("nav.theme")}
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="size-4.5 block dark:hidden" />
                  <IconSunHigh class="size-4.5 hidden dark:block" />
                </button>
              </li>
            )}

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- Language switcher chip (always last) -->
            <li class="flex items-center">
              <a
                href={targetLanguageUrl}
                class="nav-lang-chip"
                title={langToggleTitle}
                aria-label={langToggleTitle}
                data-lang-toggle={targetLocale}
              >
                <svg
                  class="nav-lang-chip-icon size-3.5 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5"
                  ></path>
                </svg>
                <span class="nav-lang-chip-label">{langChipLabel}</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <MobileMenu currentPath={currentPath} />

  <!-- Bottom border with gradient -->
  <div
    id="header-border"
    class="header-border-line h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent opacity-0 transition-opacity duration-300"
  ></div>
</header>

<script>
  import { initHeader } from "@/scripts/header";

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>
